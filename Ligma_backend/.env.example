# ── Scrybe backend ─────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Server
PORT=5000
NODE_ENV=development            # development | production | test
LOG_LEVEL=info                  # error | warn | info | debug

# Database (MongoDB Atlas recommended: workspace deletes use transactions,
# which need a replica set; a standalone mongod falls back to ordered deletes)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/scrybe

# Frontend origin. Used for CORS, the CSRF Origin check on
# /auth/refresh|logout|logout-all, and links in emails. Exact origin, no slash.
CLIENT_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m            # short-lived access JWT (kept in memory by the frontend)
REFRESH_TOKEN_TTL_DAYS=30       # httpOnly "scrybe_rt" refresh cookie lifetime
COOKIE_SECURE=                  # empty = true when NODE_ENV=production; set false for plain-http local stacks
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Reverse proxies in front of the app whose X-Forwarded-For entries are
# trusted. 1 = Render only; 2 = Vercel rewrite + Render (production).
# Verify: curl -H "X-Health-Token: $HEALTH_TOKEN" https://<vercel-app>/api/v1/health/ip
# → "ip" must be your own public IP, not a Vercel/Render address.
TRUST_PROXY_HOPS=1
PEER_RATE_LIMIT_MAX=20000

# Shared secret for GET /health/queues and /api/v1/health/ip (X-Health-Token header).
# Empty = those endpoints are disabled.
HEALTH_TOKEN=

# AI classification (optional in development)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_ENDPOINT=/chat/completions

# Email (Brevo transactional API). GMAIL_USER is the verified Brevo sender address.
BREVO_API_KEY=
GMAIL_USER=

# Redis (BullMQ queues + Socket.IO adapter)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true              # false = run without Redis (no background jobs, single instance)
