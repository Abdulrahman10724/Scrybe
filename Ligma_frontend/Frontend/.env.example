# ── Scrybe frontend ────────────────────────────────────────────────
# Copy to .env.local for local overrides. Never commit real .env files.

# REST API base URL. Leave UNSET in development and on Vercel: the app then
# calls the relative "/api/v1", which the Vite dev proxy (vite.config.js)
# and the Vercel rewrite (vercel.json) forward to the backend. Keeping the
# API same-origin is what makes the httpOnly refresh cookie first-party.
# VITE_API_URL=/api/v1

# Socket.IO connects directly to the backend (not through the proxy).
VITE_SOCKET_URL=http://localhost:5000
